[user]
      name = {{ .name }}
      email = {{ .email }}
      signingkey = {{ .signingkey }}
[commit]
      gpgsign = true
      template = {{ .chezmoi.homeDir }}/.gitmessage
[gpg]
      format = ssh
[gpg "ssh"]
	allowedSignersFile = {{ .chezmoi.homeDir }}/.config/git/allowed_signers
[core]
      editor = nvim
      excludesfile = {{ .chezmoi.homeDir }}/.config/git/ignore
[init]
      defaultBranch = main
