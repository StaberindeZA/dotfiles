if status is-interactive
    set -g fish_greeting
    set -g fish_key_bindings fish_vi_key_bindings
    bind -M insert ctrl-e edit_command_buffer
    starship init fish | source
end

fish_add_path {{ .chezmoi.homeDir }}/.local/bin
{{- if eq .chezmoi.arch "arm64" }}
fish_add_path /opt/homebrew/bin
{{- else }}
fish_add_path /usr/local/bin
{{- end }}

set -gx EDITOR nvim
set -gx VISUAL nvim
set -gx MANPAGER 'nvim +Man!'

if test -S {{ .chezmoi.homeDir }}/.bitwarden-ssh-agent.sock
    set -gx SSH_AUTH_SOCK {{ .chezmoi.homeDir }}/.bitwarden-ssh-agent.sock
end

{{- if .work }}
set -gx AWS_PROFILE mozilla
{{- end }}
